PORT=3001
JWT_SECRET=change-me-in-production

# OpenRouter — AI adjudication for ambiguous name matches + statement parsing
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=SmartRepay AI
# Speed/cost tuning for the matcher's AI step:
OPENROUTER_NITRO=true          # route to fastest providers (provider.sort=throughput)
OPENROUTER_STREAM=true         # stream tokens for lower latency
OPENROUTER_MAX_TOKENS=800      # answer budget (reasoning models need headroom before the JSON)
MATCH_CONCURRENCY=8            # parallel AI adjudications in flight
# Keep the AI step from hanging the "Run Matching" loader on rate-limited free models:
OPENROUTER_AI_CALL_RETRIES=1       # retries per ambiguous-tie call (fail fast -> deterministic)
OPENROUTER_AI_CALL_TIMEOUT_MS=20000 # per-call timeout
OPENROUTER_AI_PHASE_MAX_MS=120000  # hard ceiling for the whole AI phase
# Absolute safety net — job is force-finished if it ever exceeds this (UI loader always stops):
MATCH_JOB_TIMEOUT_MS=480000

# LoanDisk API (borrower sync for matching)
LOANDISK_API_URL=https://simplifiedapi.meanhost.in/v1/api
LOANDISK_USERNAME=api_admin
LOANDISK_PASSWORD=api_admin@2024
LOANDISK_BORROWER_ID=4617884
LOANDISK_FETCH_TIMEOUT_MS=180000
RESET_APP_DATA=false
# Optional: static token instead of Username/Password login
# LOANDISK_ACCESS_TOKEN=your_jwt_here

# Direct SQL Server access (schema migrations: npm run apply-receipts-schema --prefix server)
DB_SERVER=185.136.157.11
DB_PORT=9933
DB_DATABASE=Simplified_db
DB_USER=Simplified_user
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
