# Node.js API (default — works offline, no Supabase required)
# Proxied through Vite in dev — avoids CORS when port changes (5173, 5174, …)
VITE_API_URL=/api
VITE_USE_API=true
VITE_SIMPLIFIED_API_URL=/simplified-api

# Optional: Supabase (legacy — only if VITE_USE_API=false)
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key
